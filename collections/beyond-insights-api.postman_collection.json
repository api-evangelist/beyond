          "name": "Get market insights for a user",
          "request": {
            "name": "Get market insights for a user",
            "description": {
              "content": "Retrieve aggregated market insights for a specific user.\n\n**Required scope:** `insights:read`\n\n**Filters:** Use `filter[markets]`, `filter[clusters]`, `filter[cities]`,\n`filter[bedrooms]`, `filter[start-date]`, `filter[end-date]`, and\n`filter[currency]`\nquery parameters.\n\n**Example:** `GET /api/v1/users/42/market-insights/?filter[markets]=San Francisco&filter[currency]=USD`",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "users",
                ":user_id",
                "market-insights",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "page[number]",
                  "value": "<integer>",
                  "description": "A page number within the paginated result set."
                },
                {
                  "disabled": false,
                  "key": "page[size]",
                  "value": "<integer>",
                  "description": "Number of results to return per page."
                },
                {
                  "disabled": false,
                  "key": "filter[markets]",
                  "value": "<string>",
                  "description": "Comma-separated market names to filter by. At least one of filter[markets], filter[clusters], or filter[cities] is required."
                },
                {
                  "disabled": false,
                  "key": "filter[clusters]",
                  "value": "<string>",
                  "description": "Comma-separated cluster names to filter by. At least one of filter[markets], filter[clusters], or filter[cities] is required."
                },
                {
                  "disabled": false,
                  "key": "filter[cities]",
                  "value": "<string>",
                  "description": "Comma-separated city names to filter by. At least one of filter[markets], filter[clusters], or filter[cities] is required."
                },
                {
                  "disabled": false,
                  "key": "filter[bedrooms]",
                  "value": "<string>",
                  "description": "Comma-separated bedroom counts to filter by."
                },
                {
                  "disabled": false,
                  "key": "filter[start-date]",
                  "value": "<date>",
                  "description": "Start date (YYYY-MM-DD) used for both check-in and booked filters. Defaults to today - 365 days."
                },
                {
                  "disabled": false,
                  "key": "filter[end-date]",
                  "value": "<date>",
                  "description": "End date (YYYY-MM-DD) used for both check-in and booked filters. Defaults to today + 365 days."
                },
                {
                  "disabled": false,
                  "key": "filter[currency]",
                  "value": "<string>",
                  "description": "Currency code for prices (e.g. USD, EUR). Defaults to user's billing currency."
                },
                {
                  "disabled": false,
                  "key": "fields[market-insights]",
                  "value": "<string>,<string>",
                  "description": "endpoint return only specific fields in the response on a per-type basis by including a fields[TYPE] query parameter."
